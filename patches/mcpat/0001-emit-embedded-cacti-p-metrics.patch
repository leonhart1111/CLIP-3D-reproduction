+static void emit_embedded_cacti_p_metric(
+    const char *cache_name, int core_index, const uca_org_t &result)
+{
+	std::ios::fmtflags saved_flags = std::cout.flags();
+	std::streamsize saved_precision = std::cout.precision();
+	std::cout << std::scientific << std::setprecision(17)
+		<< "CLIP_MCPAT_CACTI_P_V1"
+		<< " cache=" << cache_name
+		<< " core=" << core_index
+		<< " access_time_s=" << result.access_time
+		<< " cycle_time_s=" << result.cycle_time
+		<< " height_mm=" << result.cache_ht * 1e-3
+		<< " width_mm=" << result.cache_len * 1e-3
+		<< " mcpat_version=1.3 model=embedded-cacti-p"
+		<< std::endl;
+	std::cout.flags(saved_flags);
+	std::cout.precision(saved_precision);
+}
