    "fft",
    "cholesky",
    "stream",
    "matmul",
    "stencil"
  ],
  "l1d_sizes": [
    "16kB",
    "32kB",
    "64kB",
    "128kB"
  ],
  "l2_sizes": [
    "128kB",
    "256kB",
    "512kB",
    "1024kB",
    "2048kB"
  ],
  "fixed_architecture": {
    "cores": 4,
