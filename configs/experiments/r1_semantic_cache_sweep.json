{
  "schema_version": 1,
  "name": "clip3d_r1_semantic_cache_sweep",
  "default_profile": "semantic",
  "workloads": [
    "fft",
    "cholesky",
    "stream",
    "matmul",
    "stencil"
  ],
  "l1d_sizes": [
    "16kB",
    "32kB",
    "64kB",
    "128kB"
  ],
  "l2_sizes": [
    "128kB",
    "256kB",
    "512kB",
    "1024kB",
    "2048kB"
  ],
  "fixed_architecture": {
    "cores": 4,
    "cpu": "X86O3CPU",
    "clock": "2GHz",
    "issue_width": 4,
    "rob_entries": 192,
    "l1i_size": "32kB",
    "l1_associativity": 2,
    "l2_associativity": 8,
    "cache_line_bytes": 64
  },
  "profiles": {
    "semantic": {
      "instruction_window_scope": "semantic-work",
      "semantic_work_units": {
        "fft": {
          "warmup": 16,
          "measure": 80,
          "type": "parallel-forward-fft"
        },
        "cholesky": {
          "warmup": 16,
          "measure": 80,
          "type": "numeric-factorization"
        },
        "stream": {
          "warmup": 3,
          "measure": 16,
          "type": "copy-scale-add-triad-iteration"
        },
        "matmul": {
          "warmup": 40,
          "measure": 200,
          "type": "balanced-row-batch"
        },
        "stencil": {
          "warmup": 80,
          "measure": 400,
          "type": "jacobi-iteration"
        }
      },
      "workload_options": {}
    }
  }
}
